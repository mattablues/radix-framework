{
  "name": "radix/framework",
  "description": "Radix Framework",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "psr/event-dispatcher": "^1.0",
    "psr/container": "^2.0",
    "dflydev/dot-access-data": "^3.0.2"
  },
  "autoload": {
    "psr-4": {
      "Radix\\": "src/"
    },
    "files": [
      "support/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Radix\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.1",
    "infection/infection": "^0.32"
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
