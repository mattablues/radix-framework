{
  "name": "radix/framework",
  "description": "Radix Framework",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "psr/event-dispatcher": "^1.0",
    "psr/container": "^2.0",
    "dflydev/dot-access-data": "^3.0.2",
    "ext-libxml": "*"
  },
  "autoload": {
    "psr-4": {
      "Radix\\": "src/"
    },
    "files": [
      "support/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Radix\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.1",
    "infection/infection": "^0.32",
    "friendsofphp/php-cs-fixer": "^3.93"
  },
  "scripts": {
    "stan": "phpstan analyse -c phpstan.neon.dist",
    "test": "php -d xdebug.mode=off vendor/bin/phpunit",
    "test:cov": "php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-text",
    "format": "php-cs-fixer fix",
    "format:check": "php-cs-fixer fix --dry-run --diff",
    "infect": "php -d xdebug.mode=coverage vendor/bin/infection --configuration=infection.json.dist --threads=4 --min-msi=90 --min-covered-msi=95"
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
